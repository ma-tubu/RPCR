#!/bin/bash

# Generic server defaults. Override these variables before submission when
# running on a specific cluster.
export PERSON_HOME="${PERSON_HOME:-$HOME}"
export PERSON_PROJECT="${PERSON_PROJECT:-$HOME/projects}"
export PERSON_SCRATCH="${PERSON_SCRATCH:-$HOME/scratch}"

export PROJECT_NAME="${PROJECT_NAME:-RPCR}"
export CODE_DIR="${CODE_DIR:-$PERSON_HOME/code/$PROJECT_NAME}"
export DATASET="${DATASET:-CMUMOSEI}"
case "$DATASET" in
  CMUMOSI) DATASET_SLUG="cmumosi" ;;
  CMUMOSEI) DATASET_SLUG="cmumosei" ;;
  CHSIMS) DATASET_SLUG="chsims" ;;
  *) echo "DATASET must be CMUMOSI, CMUMOSEI or CHSIMS, got: $DATASET" >&2; return 2 ;;
esac
export DATASET_SLUG
export FEATURE_CACHE="${FEATURE_CACHE:-$CODE_DIR/cache/ebmc_${DATASET_SLUG}_full.pt}"
export CHSIMS_PKL="${CHSIMS_PKL:-$CODE_DIR/cache/unaligned_39.pkl}"
export RUN_ROOT="${RUN_ROOT:-$PERSON_SCRATCH/runs/$PROJECT_NAME}"
export CACHE_ROOT="${CACHE_ROOT:-$PERSON_SCRATCH/cache/$PROJECT_NAME}"

export MOPE_VENV="${MOPE_VENV:-$PERSON_HOME/venvs/mope_env}"
export CONDA_ENV="${CONDA_ENV:-mope_env}"
export PYTHON_MODULE="${PYTHON_MODULE:-python/3.11}"
export SERVER_ACTIVATE_SH="${SERVER_ACTIVATE_SH:-}"

export SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"
export SLURM_PARTITION="${SLURM_PARTITION:-}"
export SLURM_TIME="${SLURM_TIME:-12:00:00}"
export SLURM_CPUS="${SLURM_CPUS:-4}"
# Trillium rejects --mem/--mem-per-cpu/--mem-per-gpu, so submission scripts
# intentionally do not expose a memory option.
export SLURM_GPUS="${SLURM_GPUS:-1}"
export MAX_CONCURRENT="${MAX_CONCURRENT:-4}"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}"
export PYTHONUNBUFFERED=1
