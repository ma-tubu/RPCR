{
  "dataset_name": "CHSIMS",
  "hidden_dim": 64,
  "visual_depth": 2,
  "audio_depth": 3,
  "text_depth": 3,
  "num_experts": 2,
  "expert_dim": 32,
  "expansion": 2,
  "dropout": 0.35,
  "epochs": 60,
  "batch_size": 24,
  "seed": 42,
  "learning_rate": 0.0002,
  "weight_decay": 0.002,
  "warmup_ratio": 0.1,
  "grad_clip": 0.5,
  "auxiliary_weight": 0.03,
  "correlation_weight": 0.05,
  "router_weight": 0.0,
  "audio_modulation_mode": "full",
  "text_modulation_mode": "full",
  "audio_condition_scale_init": 0.03,
  "text_condition_scale_init": 0.03,
  "output_activation": "tanh",
  "monitor": "Acc_3",
  "patience": 10
}
